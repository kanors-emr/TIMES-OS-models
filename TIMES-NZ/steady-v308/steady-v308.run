$TITLE Veda2 -- v5.0.0.0


OPTION PROFILE=1, SOLVEOPT=REPLACE;
OPTION RESLIM=50000, ITERLIM=999999, LIMROW=0, LIMCOL=0, SOLPRINT=OFF;



option LP=cplex;



*--If you want to use an optimizer other than cplex/xpress, enter it here:
*OPTION LP=MyOptimizer;


$OFFLISTING
*$ONLISTING


* activate validation to force VAR_CAP/COMPRD
$SET VALIDATE 'NO'
* reduction of equation system
$SET REDUCE   'YES'
*--------------------------------------------------------------*
* BATINCLUDE calls should all be with lower case file names!!! *
*--------------------------------------------------------------*


* initialize the environment variables
$   SET VDA YES 
$   SET DEBUG                          'NO'
$   SET DUMPSOL                        'NO'
$   SET SOLVE_NOW                      'YES'
$   SET MODEL_NAME                     'TIMES'
$   IF DECLARED REG      $SET STARTRUN 'RESTART'
$   IF NOT DECLARED REG  $SET STARTRUN 'SCRATCH'
$SET XTQA YES
* VAR_UC being set so that non-binding constraints appear in results
$SET VAR_UC YES 
$ SET OBJ AUTO
$ SET MID_YEAR YES
$ SET OBLONG YES
$SET DAMAGE NO
$ SET STAGES NO
$SET SOLVEDA 'YES'
$SET VARCOST LIN
$ SET DSCAUTO YES
$SET DATAGDX YES





* merge declarations & data
$   ONMULTI


* the times-slices MUST come 1st to ensure ordering OK
$BATINCLUDE steady-v308_ts.dd


*<perform fixed declarations>
$SET BOTIME 1902
$   BATINCLUDE initsys.mod


* declare the (system/user) empties
$   BATINCLUDE initmty.mod
*$   BATINCLUDE initmty.mod DSC
$IF NOT DECLARED REG_BNDCST $Abort "You need to use TIMES v2.3.1 or higher"


$BATINCLUDE base.dd
$BATINCLUDE newtechs_agr_steady.dd
$BATINCLUDE newtechs_elc_steady.dd
$BATINCLUDE newtechs_h2_steady.dd
$BATINCLUDE newtechs_tra_steady.dd
$BATINCLUDE newtechs_ind.dd
$BATINCLUDE newtechs_com.dd
$BATINCLUDE sectorclosures.dd
$BATINCLUDE demandflex_steady.dd
$BATINCLUDE lng_imports_steady.dd
$BATINCLUDE newtech_storage_steady.dd
$BATINCLUDE syssettings.dd
$BATINCLUDE trade_parms.dd
$BATINCLUDE steady.dd
$BATINCLUDE base_constraints.dd
$BATINCLUDE processheatcoalban.dd
$BATINCLUDE carbon_steady.dd
$BATINCLUDE discountrates_steady.dd
$BATINCLUDE distributedsolar_steady.dd
$BATINCLUDE eafdemand_steady.dd
$BATINCLUDE lng_build_timing_steady.dd
$BATINCLUDE renewable_availability.dd
$BATINCLUDE existingbatteryinvestment.dd
$BATINCLUDE wem_wcm.dd
$BATINCLUDE loadcurve.dd

SET MILESTONYR /2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2035,2040,2045,2050/;
$SET RUN_NAME 'steady-v308'






$ SET VEDAVDD 'YES'


* do the rest
$ BATINCLUDE maindrv.mod mod







